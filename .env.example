# Copy to .env.local and fill in to switch on real Google login (see docs/google-login.md).
# Without these, the app runs in demo mode with pretend Google accounts.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Google accounts that can open the dashboard. Everyone else who signs in is a customer.
VITE_STAFF_EMAILS=you@gmail.com:SUPER_ADMIN, her@gmail.com:ADMIN
