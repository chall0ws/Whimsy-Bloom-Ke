# Local settings for `npm run dev`. Copy to .env.local (never committed) and fill in.
# On Vercel, set these under Settings → Environment Variables instead (see docs/go-live.md).
# With nothing set, the app runs in demo mode with sample data and pretend accounts.

# Supabase → Project Settings → API. Vercel's Supabase integration sets
# SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY, which work too.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Accounts that can open the dashboard. Everyone else who signs in is a customer.
VITE_STAFF_EMAILS=you@gmail.com:SUPER_ADMIN, her@gmail.com:ADMIN

# --- Live mode: real data in Supabase and Paystack payments ---
# Server-only secrets. Never share them or put them in code.
SUPABASE_SERVICE_ROLE_KEY=
PAYSTACK_SECRET_KEY=sk_test_...
# Email Paystack uses for guests who don't give one (optional).
PAYSTACK_RECEIPT_EMAIL=
# Switch on last, after running the SQL in supabase/migrations.
VITE_LIVE=false
